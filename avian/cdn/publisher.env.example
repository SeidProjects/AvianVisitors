# PRIVATE SERVER SETTINGS. Copy outside the checkout; keep the copy mode 0600.
# Disabled unless explicitly enabled or all required settings are supplied.
AVIAN_SYNC_ENABLED=0
AVIAN_SYNC_ENDPOINT_URL=
AVIAN_SYNC_BUCKET=
AVIAN_SYNC_PUBLIC_ORIGIN=
AVIAN_SYNC_ACCESS_KEY_ID=
AVIAN_SYNC_SECRET_ACCESS_KEY=
AVIAN_SYNC_AUDIO_ROOT=
AVIAN_SYNC_IMAGE_ROOT=
# Alternative to IMAGE_ROOT: up to eight separate, disjoint artwork roots.
AVIAN_SYNC_IMAGE_ROOTS=
AVIAN_SYNC_STATE_DIR=
AVIAN_SYNC_DB_PATH=
AVIAN_SYNC_TIMEZONE=

# Optional private mappings and cached plain-text descriptions.
AVIAN_SYNC_IMAGE_MAP_FILE=
AVIAN_SYNC_WIKI_CACHE_FILE=
# Optional private WebSocket notifier; never include this token in browser config.
AVIAN_SYNC_NOTIFY_URL=
AVIAN_SYNC_NOTIFY_TOKEN=
# AVIAN_SYNC_NOTIFY_URL=https://updates.example.net/notify
# Use the same random private token as the Worker's UPDATES_PUBLISH_TOKEN secret.
AVIAN_SYNC_CACHE_PREFIX=data

# Keep the current frontend cache; retire only publisher-owned obsolete metadata.
# Original files, remote audio/images, and unknown bucket keys are never deleted.
AVIAN_SYNC_CLEANUP_CURRENT_CACHE=1
AVIAN_SYNC_FIX_LAST_HOUR=0
# Optional complete annual per-bird daily occurrence counts (schema 3).
# Default 0 preserves schema 2; existing resource allowances stay unchanged.
AVIAN_SYNC_SEASONALITY=0

# Repeat a bounded cycle every 15 minutes; --loop opts into repetition.
# A smaller interval accelerates backfill; review whole-account usage first.
AVIAN_SYNC_INTERVAL_SECONDS=900
AVIAN_SYNC_BACKOFF_SECONDS=60
AVIAN_SYNC_BATCH_FILES=24
AVIAN_SYNC_BATCH_BYTES=16777216
AVIAN_SYNC_FILE_BYTES=8388608
AVIAN_SYNC_SCAN_ENTRIES=1024
AVIAN_SYNC_MIN_FREE_BYTES=1610612736
AVIAN_SYNC_MAX_SOURCES=100000
AVIAN_SYNC_MAX_DIRECTORIES=10000
AVIAN_SYNC_MAX_OBJECTS=150000
AVIAN_SYNC_LOCAL_STATE_BYTES=134217728
AVIAN_SYNC_MAX_REMOTE_MEDIA_BYTES=8589934592
# Account for verified pre-existing/untracked media; fixed in target identity.
AVIAN_SYNC_REMOTE_RESERVED_BYTES=0

# Neutral shapes (use your own values, with resolved absolute disjoint roots):
# AVIAN_SYNC_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AVIAN_SYNC_BUCKET=bird-media
# AVIAN_SYNC_PUBLIC_ORIGIN=https://media.example.net
# AVIAN_SYNC_AUDIO_ROOT=/srv/recorder/recordings
# AVIAN_SYNC_IMAGE_ROOT=/srv/recorder/artwork
# Or leave IMAGE_ROOT empty and set the literal JSON alternative:
# AVIAN_SYNC_IMAGE_ROOTS={"drawings":"/srv/art/drawings","photos":"/srv/art/photos"}
# AVIAN_SYNC_STATE_DIR=/var/lib/avian-cdn
# AVIAN_SYNC_DB_PATH=/srv/recorder/BirdDB.txt
# AVIAN_SYNC_TIMEZONE=Europe/London
