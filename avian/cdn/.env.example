# Public browser build settings only. No credentials belong in this file.
# 0 keeps the application's existing origin behavior; 1 requires CDN settings.
AVIAN_CDN_ENABLED=0
AVIAN_MEDIA_ORIGIN=
AVIAN_SNAPSHOT_INDEX_URL=
AVIAN_WIKI_INDEX_URL=

# Neutral examples: configure your own HTTPS CDN before enabling.
# AVIAN_CDN_ENABLED=1
# AVIAN_MEDIA_ORIGIN=https://media.example.net
# AVIAN_SNAPSHOT_INDEX_URL=https://media.example.net/data/snapshot-index.json
# AVIAN_WIKI_INDEX_URL=https://media.example.net/data/descriptions.json

# With the flag absent, both required public URLs automatically enable CDN mode.
# Any partial configuration fails the build. No public configuration defaults off.
# The publisher and scheduled sync use separate private server configuration.
